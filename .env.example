# Application Settings
APP_NAME="BlastRadius Agent"
APP_ENV=development
DEBUG=True

# FalkorDB Database Configuration
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_GRAPH_NAME=blast_radius

# LLM Configuration (LiteLLM supports OpenAI, Anthropic, Gemini, Ollama, etc.)
LLM_MODEL=gemini/gemini-2.5-flash
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Remediation & Policy Engine
DEFAULT_REMEDIATION_MODE=approval
MAX_TRAVERSAL_HOPS=4
